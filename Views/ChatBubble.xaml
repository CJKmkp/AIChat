<UserControl x:Class="AIChat.Views.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:ai="clr-namespace:AIChat"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="500">
    <UserControl.Resources>
        <!-- 本地色板：与 ChatWindow 一致的玻璃叠加与次级文本色，集中便于统一调整 -->
        <SolidColorBrush x:Key="ChatOverlayBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ChatSecondaryTextBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="ChatSubtleTextBrush" Color="#BFFFFFFF"/>
        <SolidColorBrush x:Key="ChatThinkingBackgroundBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="ChatThinkingBorderBrush" Color="#26FFFFFF"/>

        <Style x:Key="BubbleIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatingBarForegroundBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 思考折叠头：无 chrome 纯文字按钮 -->
        <Style x:Key="ThinkingToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatingBarForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="2,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Margin="0,6" Padding="0" HorizontalAlignment="Stretch">
        <Grid>
            <!-- 用户消息：右对齐，主色块 + 头像 -->
            <Grid x:Name="UserBlock"
                  HorizontalAlignment="Right"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        CornerRadius="14"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        MaxWidth="380"
                        Background="{DynamicResource FloatingBarAccentBrush}">
                    <TextBlock x:Name="UserText"
                               TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="14"/>
                </Border>
                <Border Grid.Column="1"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Background="{DynamicResource ChatOverlayBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="👤" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- AI 消息：左对齐，头像 + 名字 + 段落 + 操作按钮 -->
            <StackPanel x:Name="AiBlock"
                        HorizontalAlignment="Left"
                        MaxWidth="440"
                        Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            Margin="0,0,8,0"
                            CornerRadius="16"
                            Background="{DynamicResource ChatOverlayBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="🤖" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AiName"
                               Grid.Column="1"
                               Text="{Binding BubbleName, Source={x:Static ai:Localized.Current}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ChatSecondaryTextBrush}"
                               Margin="0,2,0,4"/>
                </Grid>
                <!-- 思考过程（可折叠）：有 thinking 内容时显示折叠头，展开看推理文本 -->
                <StackPanel x:Name="ThinkingSection"
                            Margin="40,0,0,6"
                            Visibility="Collapsed">
                    <Button x:Name="ThinkingToggle"
                            Style="{StaticResource ThinkingToggleStyle}"
                            HorizontalAlignment="Left"
                            Click="ThinkingToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💭" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ThinkingLabel, Source={x:Static ai:Localized.Current}}"
                                       FontSize="12"
                                       Margin="4,0,3,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FloatingBarForegroundBrush}"/>
                            <TextBlock x:Name="ThinkingChevron"
                                       Text="▾"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="ThinkingBody"
                            Margin="0,6,0,0"
                            Background="{DynamicResource ChatThinkingBackgroundBrush}"
                            BorderBrush="{DynamicResource ChatThinkingBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ThinkingText"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{DynamicResource ChatSubtleTextBrush}"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="AiText"
                           Margin="40,0,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FloatingBarForegroundBrush}"
                           FontSize="14"
                           LineHeight="22"/>
                <TextBlock x:Name="AiStreaming"
                           Margin="40,4,0,0"
                           Text="{Binding Streaming, Source={x:Static ai:Localized.Current}}"
                           Foreground="{DynamicResource ChatSecondaryTextBrush}"
                           FontSize="12"
                           Visibility="Collapsed"/>
                <!-- 思考中动画（三点跳动） -->
                <TextBlock x:Name="AiThinking"
                           Margin="40,8,0,0"
                           FontSize="14"
                           Foreground="{DynamicResource ChatSecondaryTextBrush}"
                           Visibility="Collapsed">
                    <Run Text="●"/><Run Text="  "/><Run Text="●"/><Run Text="  "/><Run Text="●"/>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard x:Name="ThinkingStoryboard" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.2" To="1" Duration="0:0:0.4"
                                                     AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <!-- 操作按钮：复制 / 插入画布 / 重新生成 -->
                <ikw:SimpleStackPanel x:Name="AiActions"
                                       Margin="40,8,0,0"
                                       Orientation="Horizontal"
                                       Spacing="6"
                                       Visibility="Collapsed">
                    <Button x:Name="BtnCopy"
                            Content="{Binding BtnCopy, Source={x:Static ai:Localized.Current}}"
                            Style="{StaticResource BubbleIconButtonStyle}"
                            Click="BtnCopy_Click"/>
                    <Button x:Name="BtnInsert"
                            Content="{Binding BtnInsert, Source={x:Static ai:Localized.Current}}"
                            Style="{StaticResource BubbleIconButtonStyle}"
                            Click="BtnInsert_Click"/>
                    <Button x:Name="BtnRegenerate"
                            Content="{Binding BtnRegenerate, Source={x:Static ai:Localized.Current}}"
                            Style="{StaticResource BubbleIconButtonStyle}"
                            Click="BtnRegenerate_Click"/>
                </ikw:SimpleStackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>