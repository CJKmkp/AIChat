<UserControl x:Class="AIChat.Views.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ai="clr-namespace:AIChat"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="500">
    <Border Margin="0,6" Padding="0" HorizontalAlignment="Stretch">
        <Grid>
            <!-- 用户消息：右对齐，无气泡，仅头像 + 文字块 -->
            <Grid x:Name="UserBlock"
                  HorizontalAlignment="Right"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        CornerRadius="14"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        MaxWidth="380"
                        Background="{DynamicResource FloatingBarAccentBrush}">
                    <TextBlock x:Name="UserText"
                               TextWrapping="Wrap"
                               Foreground="White"
                               FontSize="14"/>
                </Border>
                <Border Grid.Column="2"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Background="#22FFFFFF"
                        VerticalAlignment="Top">
                    <TextBlock Text="👤" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- AI 消息：左对齐，无气泡，仅头像 + 文字段落 + 操作按钮 -->
            <StackPanel x:Name="AiBlock"
                        HorizontalAlignment="Left"
                        MaxWidth="440"
                        Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            Margin="0,0,8,0"
                            CornerRadius="16"
                            Background="#22FFFFFF"
                            VerticalAlignment="Top">
                        <TextBlock Text="🤖" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AiName"
                               Grid.Column="1"
                               Text="AI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#99FFFFFF"
                               Margin="0,2,0,4"/>
                </Grid>
                <TextBlock x:Name="AiText"
                           Margin="40,0,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FloatingBarForegroundBrush}"
                           FontSize="14"
                           LineHeight="22"/>
                <TextBlock x:Name="AiStreaming"
                           Margin="40,4,0,0"
                           Text="{Binding Streaming, Source={x:Static ai:Localized.Current}}"
                           Foreground="#99FFFFFF"
                           FontSize="12"
                           Visibility="Collapsed"/>
                <!-- 操作按钮 -->
                <StackPanel x:Name="AiActions"
                            Margin="40,8,0,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button x:Name="BtnCopy"
                            Content="{Binding BtnCopy, Source={x:Static ai:Localized.Current}}"
                            Padding="10,3" Margin="0,0,4,0"
                            Background="Transparent"
                            BorderBrush="#40FFFFFF"
                            Foreground="{DynamicResource FloatingBarForegroundBrush}"
                            Click="BtnCopy_Click"/>
                    <Button x:Name="BtnInsert"
                            Content="{Binding BtnInsert, Source={x:Static ai:Localized.Current}}"
                            Padding="10,3" Margin="0,0,4,0"
                            Background="Transparent"
                            BorderBrush="#40FFFFFF"
                            Foreground="{DynamicResource FloatingBarForegroundBrush}"
                            Click="BtnInsert_Click"/>
                    <Button x:Name="BtnRegenerate"
                            Content="{Binding BtnRegenerate, Source={x:Static ai:Localized.Current}}"
                            Padding="10,3"
                            Background="Transparent"
                            BorderBrush="#40FFFFFF"
                            Foreground="{DynamicResource FloatingBarForegroundBrush}"
                            Click="BtnRegenerate_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>