<Window x:Class="AIChat.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AIChat.Views"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
        xmlns:ai="clr-namespace:AIChat"
        mc:Ignorable="d"
        Title="AI Chat"
        Width="480" Height="700"
        MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <!--
        窗口资源：
        - IconButtonStyle：无 chrome 的纯图标按钮（去掉 WPF Button 默认边框矩形）
        - 输入区图标按钮沿用此 Style
    -->
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FloatingBarForegroundBrush}"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FloatingBarAccentBrush}"/>
        </Style>

        <!-- 本地色板：玻璃面上的白色半透明叠加与次级文本色。
             默认浮动栏为深色玻璃底，固定白 alpha 叠加与其一致；
             集中在窗口级资源便于统一调整/兼容自定义浮动栏主题。 -->
        <SolidColorBrush x:Key="ChatOverlayBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="ChatSecondaryTextBrush" Color="#99FFFFFF"/>
    </Window.Resources>

    <Border Background="{DynamicResource FloatingBarBackgroundBrush}"
            BorderBrush="{DynamicResource FloatingBarBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.35" BlurRadius="8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：模型下拉（左）+ 操作按钮（右）；可拖动 -->
            <Grid Grid.Row="0" Margin="14,0,10,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ChatOverlayBrush}"
                        CornerRadius="8"
                        Padding="8,3"
                        MaxHeight="28"
                        Cursor="Hand"
                        PreviewMouseLeftButtonDown="ModelPicker_PreviewMouseLeftButtonDown"
                        MouseLeftButtonUp="ModelPicker_Click">
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock x:Name="ModelNameText"
                                   Text="deepseek-chat"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>
                        <TextBlock Text="▾"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FloatingBarForegroundBrush}"
                                   FontSize="10"/>
                    </ikw:SimpleStackPanel>
                </Border>

                <ikw:SimpleStackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="BtnClear"
                            Style="{StaticResource IconButtonStyle}"
                            Width="34" Height="34"
                            Click="BtnClear_Click"
                            ToolTip="{Binding BtnClear, Source={x:Static ai:Localized.Current}}">
                        <ui:FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource IconButtonStyle}"
                            Width="34" Height="34"
                            Click="BtnClose_Click"
                            ToolTip="{Binding BtnClose, Source={x:Static ai:Localized.Current}}">
                        <ui:FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </ikw:SimpleStackPanel>
            </Grid>

            <!-- 消息区 -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="120" Height="120"
                            CornerRadius="60"
                            Background="{DynamicResource ChatOverlayBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🤖"
                                   FontSize="56"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle, Source={x:Static ai:Localized.Current}}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4"
                               Foreground="{DynamicResource FloatingBarForegroundBrush}"/>
                    <TextBlock Text="{Binding EmptyDesc, Source={x:Static ai:Localized.Current}}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ChatSecondaryTextBrush}"/>
                </StackPanel>

                <ScrollViewer x:Name="MessagesScroll"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              ScrollViewer.CanContentScroll="True"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MessagesList"
                                  Margin="14,8,14,8"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:ChatBubble/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 底部胶囊输入条 -->
            <Border Grid.Row="2"
                    Margin="14,8,14,14"
                    Background="{DynamicResource ChatOverlayBrush}"
                    CornerRadius="22"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             MinHeight="36" MaxHeight="120"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource FloatingBarForegroundBrush}"
                             VerticalContentAlignment="Center"
                             Padding="4,0,4,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PreviewKeyDown="InputBox_PreviewKeyDown"/>

                    <!-- 右侧发送/停止按钮（互斥显示） -->
                    <Grid Grid.Column="1">
                        <Button x:Name="BtnSend"
                                Style="{StaticResource AccentIconButtonStyle}"
                                Width="40" Height="36"
                                Click="BtnSend_Click"
                                ToolTip="{Binding BtnSend, Source={x:Static ai:Localized.Current}}">
                            <ui:FontIcon Glyph="&#xE724;" FontSize="16"/>
                        </Button>
                        <Button x:Name="BtnStop"
                                Style="{StaticResource IconButtonStyle}"
                                Width="40" Height="36"
                                Visibility="Collapsed"
                                Click="BtnStop_Click"
                                ToolTip="{Binding BtnStop, Source={x:Static ai:Localized.Current}}">
                            <ui:FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#DC2626"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <!-- 右下角缩放柄（自绘）：WindowStyle=None + AllowsTransparency 下系统 grip 落在窗口直角角点、
                 会溢出圆角；这里放到圆角内右下角，按下走 SC_SIZE + HTBOTTOMRIGHT 系统缩放循环 -->
            <Path Grid.Row="0" Grid.RowSpan="3"
                  Data="M1,11 L11,1 M1,7 L7,1 M1,3 L3,1"
                  Width="12" Height="12"
                  Stroke="{DynamicResource FloatingBarForegroundBrush}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Margin="0,0,6,6"
                  Opacity="0.4"
                  Cursor="SizeNWSE"
                  PreviewMouseLeftButtonDown="ResizeGrip_PreviewMouseLeftButtonDown"
                  ToolTip="{Binding BtnResize, Source={x:Static ai:Localized.Current}}"/>
        </Grid>
    </Border>
</Window>