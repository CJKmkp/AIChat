<UserControl x:Class="AIChat.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AIChat.Views"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ai="clr-namespace:AIChat"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="680">
    <!--
        注意：宿主 PluginSettingsPage 外层已包 ScrollViewer(PanningMode=VerticalFirst)，
        这里不要再包 ScrollViewer，否则嵌套滚动条会导致全页滚动失效。
        滚动由宿主页面统一处理。
    -->
    <Grid>
        <FrameworkElement.Resources>
            <sys:Double x:Key="SettingsCardSpacing">6</sys:Double>
        </FrameworkElement.Resources>
        <ikw:SimpleStackPanel MaxWidth="920"
                              HorizontalAlignment="Stretch"
                              Spacing="{StaticResource SettingsCardSpacing}">

            <ui:InfoBar IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="AI 助手设置"
                        Message="在 AI 提供商处申请 Key 后填入。API Key 仅本地保存，并用 DPAPI 加密。"/>

            <ui:SettingsCard Header="接口协议">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE8F5;"/>
                </ui:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ProtocolCombo" MinWidth="220"
                          SelectionChanged="ProtocolCombo_SelectionChanged">
                    <ComboBoxItem Content="OpenAI 兼容" Tag="openai"/>
                    <ComboBoxItem Content="Anthropic Claude" Tag="anthropic"/>
                </ComboBox>
            </ui:SettingsCard>

            <TextBlock x:Name="ProtocolNote"
                       Foreground="Gray"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="52,0,0,0"/>

            <ui:SettingsCard Header="AI 提供商"
                              Description="选择预设后自动填入接口地址与协议">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE7BF;"/>
                </ui:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ProviderCombo" MinWidth="260"
                          SelectionChanged="ProviderCombo_SelectionChanged"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="接口地址 (Base URL)">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE774;"/>
                </ui:SettingsCard.HeaderIcon>
                <TextBox x:Name="BaseUrlBox" MinWidth="340"
                         VerticalContentAlignment="Center"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="API Key">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE192;"/>
                </ui:SettingsCard.HeaderIcon>
                <Grid MinWidth="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0"/>
                    <TextBox x:Name="ApiKeyPlainBox" Grid.Column="0" Visibility="Collapsed"/>
                    <Button x:Name="BtnToggleKey" Grid.Column="1"
                            MinWidth="72" Margin="10,0,0,0"
                            Content="显示" Click="BtnToggleKey_Click"/>
                </Grid>
            </ui:SettingsCard>

            <ui:SettingsCard Header="模型"
                              Description="可点「拉取模型」从接口获取可用模型列表">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE8D0;"/>
                </ui:SettingsCard.HeaderIcon>
                <Grid MinWidth="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelBox" Grid.Column="0"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnFetchModels" Grid.Column="1"
                            MinWidth="96" Margin="10,0,0,0"
                            Content="拉取模型" Click="BtnFetchModels_Click"/>
                </Grid>
            </ui:SettingsCard>

            <ui:SettingsCard Header="系统提示词"
                              Description="定义助手角色、语气、回答格式">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE82D;"/>
                </ui:SettingsCard.HeaderIcon>
                <TextBox x:Name="SystemPromptBox"
                         MinWidth="340" MinHeight="80" MaxHeight="180"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </ui:SettingsCard>

            <ui:SettingsCard Header="高级（可选）"
                              Description="温度（0 表示不发送）和 Max Tokens">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE7AF;"/>
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TemperatureBox" MinWidth="88"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="温度" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBox x:Name="MaxTokensBox" MinWidth="88"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="Max Tokens" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </ui:SettingsCard>

            <!-- 底部：状态 + 操作按钮，左右分布，间距拉开 -->
            <Grid Margin="4,16,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="Gray"/>
                <Button x:Name="BtnTest" Grid.Column="1"
                        Content="测试连接" MinWidth="120" MinHeight="36"
                        Margin="0,0,12,0"
                        Click="BtnTest_Click"/>
                <Button x:Name="BtnSave" Grid.Column="2"
                        Content="保存" MinWidth="120" MinHeight="36"
                        Click="BtnSave_Click"/>
            </Grid>
        </ikw:SimpleStackPanel>
    </Grid>
</UserControl>