<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>AIChat</RootNamespace>
    <AssemblyName>AIChat</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      所需宿主服务接口（IThemeService / IScreenInfoService / ICanvasElementService 等）
      当前的 NuGet 包 InkCanvas.PluginSdk 1.7.19.9-* 暂未包含，因此引用主仓库 SDK 源码。
      待 SDK 发布包含全部接口的新版 NuGet 后，可改回 PackageReference 并按 SDK 实际版本号升版。
    -->
    <ProjectReference Include="..\ICC CE main\community\InkCanvas.PluginSdk\InkCanvas.PluginSdk.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 排除子目录中的测试项目（SDK 风格默认会编译 **/*.cs） -->
  <ItemGroup>
    <Compile Remove="AIChat.Tests\**\*.cs" />
    <None Remove="AIChat.Tests\**" />
  </ItemGroup>

</Project>