<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>AIChat</RootNamespace>
    <AssemblyName>AIChat</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 所需宿主服务接口（IThemeService / IScreenInfoService / ICanvasElementService 等）：
         1.7.19.9-gda522a8757 起 NuGet 已包含，故改回 PackageReference（与其它插件一致，
         GitHub CI 不再依赖本地 SDK 源码路径）。升版时以 nuget.org 实际版本号为准。 -->
    <PackageReference Include="InkCanvas.PluginSdk" Version="1.7.19.9-gda522a8757" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 排除子目录中的测试项目（SDK 风格默认会编译 **/*.cs） -->
  <ItemGroup>
    <Compile Remove="AIChat.Tests\**\*.cs" />
    <None Remove="AIChat.Tests\**" />
  </ItemGroup>

</Project>